# Bash only: copy to .env if it does not exist, then run: source .env
# Merge settings into an existing .env; keep API keys out of this example.

_cache_workspace="/dss/dssfs05/lwp-dss-0003/pn39je/pn39je-dss-0004/go46wuw2_2"
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-$_cache_workspace}"

# Keep the existing LRZ project datasets cache.
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$_cache_workspace/.cache/projects/low-resource-generation/datasets}"

source "$_cache_workspace/.agents/config/cache/env.sh" low-resource-generation || return $?
unset _cache_workspace

# Raw corpora may be overridden independently of cache paths.
export CORPUS_ROOT="${CORPUS_ROOT:-$WORKSPACE_ROOT/Corpora}"

# API evaluation: preserve exported values; the default key is empty.
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://openrouter.ai/api/v1}"
