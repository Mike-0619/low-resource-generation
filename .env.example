# Cache overrides must resolve inside the workspace root .cache/.
_cache_workspace="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-$_cache_workspace}"
source "$_cache_workspace/config/cache.sh" low-resource-generation || return $?
unset _cache_workspace

# Local Bash configuration: copy to .env and edit the default values.
export CORPUS_ROOT="${CORPUS_ROOT-${WORKSPACE_ROOT}/Corpora}"

export OPENAI_API_KEY="${OPENAI_API_KEY-}"
export OPENAI_BASE_URL="${OPENAI_BASE_URL-https://openrouter.ai/api/v1}"
